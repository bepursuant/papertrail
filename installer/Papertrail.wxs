<?xml version="1.0" encoding="utf-8"?>
<!--
  papertrail MSI. Built with WiX Toolset 5.0.2 (MS-RL, no Open Source Maintenance Fee; pinned in
  .config/dotnet-tools.json) by scripts/build-msi.ps1. Do not move to WiX 6 or later without
  settling the OSMF.

  Per-user package: no elevation prompt, installs to %LOCALAPPDATA%\Programs\Papertrail, basic
  UI (progress bar only). It uses no WiX extensions, so the MSI contains no WiX binaries.

  Properties (msiexec /i papertrail.msi NAME=value):
    AUTOSTART=0          don't start papertrail at sign-in
    LAUNCHAPP=0          don't start papertrail when the install finishes
    SKIPRUNTIMECHECK=1   install even if the .NET runtimes aren't found (custom .NET location)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="papertrail"
      Manufacturer="Pursuant Solutions"
      Version="$(var.ProductVersion)"
      UpgradeCode="7235DF8D-063A-4C39-9ADB-A57FF9B2B533"
      Scope="perUser"
      Language="1033"
      Compressed="yes">

    <SummaryInformation Description="papertrail - scan documents from web pages" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of papertrail is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="AUTOSTART" Value="1" />
    <Property Id="LAUNCHAPP" Value="1" />

    <!-- Framework-dependent build: needs the x86 .NET Desktop Runtime and ASP.NET Core Runtime 10.
         The x86 runtimes always live under the 32-bit Program Files folder. -->
    <Property Id="DESKTOPRUNTIME">
      <DirectorySearch Id="DesktopRuntimeVersions" Path="[ProgramFilesFolder]dotnet\shared\Microsoft.WindowsDesktop.App" Depth="1">
        <FileSearch Name="PresentationFramework.dll" MinVersion="10.0.0.0" MaxVersion="10.65535.65535.65535" />
      </DirectorySearch>
    </Property>
    <Property Id="ASPNETRUNTIME">
      <DirectorySearch Id="AspNetRuntimeVersions" Path="[ProgramFilesFolder]dotnet\shared\Microsoft.AspNetCore.App" Depth="1">
        <FileSearch Name="Microsoft.AspNetCore.dll" MinVersion="10.0.0.0" MaxVersion="10.65535.65535.65535" />
      </DirectorySearch>
    </Property>
    <Launch
        Condition="Installed OR SKIPRUNTIMECHECK OR (DESKTOPRUNTIME AND ASPNETRUNTIME)"
        Message="papertrail needs two free Microsoft components, in their 32-bit (x86) versions: the .NET Desktop Runtime 10 and the ASP.NET Core Runtime 10.&#13;&#10;&#13;&#10;Download and install both, then run this installer again:&#13;&#10;https://aka.ms/dotnet/10.0/windowsdesktop-runtime-win-x86.exe&#13;&#10;https://aka.ms/dotnet/10.0/aspnetcore-runtime-win-x86.exe&#13;&#10;&#13;&#10;Both are also listed at https://dotnet.microsoft.com/download/dotnet/10.0" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Papertrail" />
      </Directory>
    </StandardDirectory>

    <!-- Per-user components use HKCU key paths (ICE38/ICE43) and remove their folders (ICE64). -->
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="21FE18E6-8B52-4E15-957A-BC1BBD945937">
        <File Id="PapertrailExe" Source="$(var.PublishDir)\Papertrail.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Pursuant Solutions\papertrail" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>

      <!-- Same keys as the app's own register switch (WindowsRegistration.cs). -->
      <Component Id="ProtocolHandler">
        <RegistryKey Root="HKCU" Key="Software\Classes\papertrail">
          <RegistryValue Type="string" Value="URL:papertrail scanning" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#PapertrailExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#PapertrailExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
      </Component>

      <!-- The tray menu's "Start when I sign in" toggles the same Run value, so it is not the key path. -->
      <Component Id="AutoStart" Condition="AUTOSTART = &quot;1&quot;">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Papertrail" Type="string" Value="&quot;[#PapertrailExe]&quot; --background" />
        <RegistryValue Root="HKCU" Key="Software\Pursuant Solutions\papertrail" Name="AutoStart" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="PapertrailShortcut" Name="papertrail" Description="Scan documents from web pages" Target="[#PapertrailExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Pursuant Solutions\papertrail" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="papertrail">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Plain EXE custom actions (no WiX custom-action DLLs). The exit switch asks the running
         tray app to quit and waits for it, so upgrades and uninstalls never hit files in use. -->
    <CustomAction Id="StopRunningPapertrail" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Papertrail.exe&quot; --exit" Execute="immediate" Return="ignore" />
    <CustomAction Id="StartPapertrail" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Papertrail.exe&quot; --background" Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="StopRunningPapertrail" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="StartPapertrail" After="InstallFinalize" Condition="LAUNCHAPP = &quot;1&quot; AND NOT (REMOVE ~= &quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
