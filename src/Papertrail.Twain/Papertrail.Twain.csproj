<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Papertrail.Twain</RootNamespace>
    <!-- NTwain's internal message loop uses the WPF Dispatcher; System.Drawing converts DIBs to PNG. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NTwain" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Papertrail.Core\Papertrail.Core.csproj" />
  </ItemGroup>

</Project>
