<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Papertrail.App</RootNamespace>
    <AssemblyName>Papertrail</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 32-bit only: a process only sees TWAIN drivers of its own bitness, and 32-bit drivers are the common case. -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <!-- `dotnet publish` makes one framework-dependent Papertrail.exe. It needs the x86 .NET Desktop
         Runtime and ASP.NET Core Runtime 10; the MSI checks for both. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Papertrail.Core\Papertrail.Core.csproj" />
    <ProjectReference Include="..\Papertrail.Server\Papertrail.Server.csproj" />
    <ProjectReference Include="..\Papertrail.Twain\Papertrail.Twain.csproj" />
  </ItemGroup>

</Project>
