<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Papertrail.SampleSite</RootNamespace>
  </PropertyGroup>

  <!-- Copied under "site", not "wwwroot": linked wwwroot items become static web assets, which in the
       Development environment (Visual Studio F5) make the project's non-existent wwwroot folder a
       content root and crash startup. Program.cs serves this folder only when the repo isn't found. -->
  <ItemGroup>
    <Content Include="..\web\**\*" LinkBase="site" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\clients\js\papertrail.js" Link="site\lib\papertrail.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
